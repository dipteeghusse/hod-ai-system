# ══════════════════════════════════════════════════════════════
#  HOD AI System — Environment Configuration
#  Copy this file to .env and fill in your values.
#  ALL fields marked (required) must be set before starting.
# ══════════════════════════════════════════════════════════════

# ── LLM (required) ────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here          # Get free key at console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile           # Change to any Groq-supported model

# ── LangSmith Tracing (optional but recommended) ──────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here  # Get free key at smith.langchain.com
LANGCHAIN_PROJECT=hod-ai-system
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./hod_system.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/hod_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ───────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Email / SMTP ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@institution.ac.in
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@institution.ac.in

# ══════════════════════════════════════════════════════════════
#  INSTITUTION SETTINGS  ← Change these for your college/dept
# ══════════════════════════════════════════════════════════════

APP_NAME=HOD AI System
HOD_EMAIL=hod@institution.ac.in
INSTITUTION=My Institution
DEPARTMENT=Computer Science & Engineering
PROGRAM_LEVEL=B.Tech                    # B.Tech | M.Tech | MCA | BCA | M.Sc
ACADEMIC_YEAR=2025-26
ACCREDITATION_BODY=NBA                  # NBA | NAAC | ABET | AICTE | other

# ── Task Categories (comma-separated, add/remove freely) ──────
TASK_CATEGORIES=academic,research,administrative,examination,accreditation,events,student_activities,laboratory,placement

# ── Subjects / Courses (comma-separated — your actual course names) ──
SUBJECTS=Data Structures,Algorithms,Database Management,Operating Systems,Computer Networks,Software Engineering,Machine Learning,Web Technology

# ── Faculty Designation options (comma-separated) ────────────
DESIGNATIONS=Professor,Associate Professor,Assistant Professor,Senior Assistant Professor,Lab Instructor,Adjunct Faculty

# ── Activity types for performance/API scoring ───────────────
ACTIVITY_TYPES=journal_publication,conference_paper,patent,funded_project,fdp_attended,fdp_organized,guest_lecture,workshop,certification,consultancy,phd_guidance,hackathon,industrial_visit

# ── Accreditation Criteria (pipe-separated key:label pairs) ──
# Edit these to match your accreditation body's exact criterion titles
ACCREDITATION_CRITERIA=1:Vision Mission & PEOs|2:Program Outcomes & Course Outcomes|3:Curriculum & Teaching-Learning|4:Students Performance|5:Faculty Contributions|6:Facilities & Technical Support|7:Continuous Improvement|8:First Year Academics

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── RAG / Embeddings ───────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./rag/vector_store
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
