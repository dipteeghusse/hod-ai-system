# === LLM Configuration ===
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === LangSmith Tracing ===
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=hod-ai-system
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./hod_system.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/hod_db

# === Redis (for Celery task queue) ===
REDIS_URL=redis://localhost:6379/0

# === JWT Auth ===
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hodaiml_AI@mitaoe.ac.in
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=hodaiml_AI@mitaoe.ac.in

# === Application ===
APP_NAME=HOD AI System - MITAOE CSE-AIML
HOD_EMAIL=hodaiml_AI@mitaoe.ac.in
DEPARTMENT=CSE (AI & ML)
INSTITUTION=MITAOE
ACADEMIC_YEAR=2025-26
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === RAG ===
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./rag/vector_store
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
