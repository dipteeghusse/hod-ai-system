# ── Root .dockerignore — excludes both backend and frontend build contexts ─────

# Git
.git/
.gitignore

# Documentation
README.md
*.md
docs/

# Environment (always excluded — injected at runtime)
.env
.env.*
!.env.example

# Python artifacts
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/*.egg-info/
backend/dist/
backend/build/

# Database / ML artifacts
backend/*.db
backend/*.sqlite
backend/rag/vector_store/
backend/**/*.faiss
backend/**/*.pkl

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.npm/
frontend/.cache/
frontend/*.tsbuildinfo

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Tests
.pytest_cache/
.coverage
htmlcov/
